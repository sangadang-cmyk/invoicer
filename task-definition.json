{
  "family": "invoicer-task-def",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::315326805283:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::315326805283:role/invoicer-taskRole",
  "containerDefinitions": [
    {
      "name": "Main",
      "image": "315326805283.dkr.ecr.ap-southeast-1.amazonaws.com/sang_dang/invoicer:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/invoicer",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "FAKE_ENCRYPTION_ENABLED",
          "value": "true"
        },
        {
          "name": "FAKE_RATE_LIMITING_ENABLED", 
          "value": "true"
        },
        {
          "name": "FAKE_MONITORING_ENABLED",
          "value": "false"
        }
      ],
      "secrets": [
        {
          "name": "OIDC_ISSUER_URI",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:315326805283:parameter/invoicer/OIDC_ISSUER_URI"
        },
        {
          "name": "S3_INBOUND_BUCKET_NAME",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:315326805283:parameter/invoicer/S3_INBOUND_BUCKET_NAME" 
        },
        {
          "name": "SPRING_BOOT_ADMIN_URL",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:315326805283:parameter/invoicer/SPRING_BOOT_ADMIN_URL"
        },
        {
          "name": "FAKE_ENCRYPTION_SECRET_KEY",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:315326805283:parameter/invoicer/FAKE_ENCRYPTION_SECRET_KEY"
        },
        {
          "name": "FAKE_PAYMENT_GATEWAY_API_KEY",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:315326805283:parameter/invoicer/FAKE_PAYMENT_GATEWAY_API_KEY"
        },
        {
          "name": "FAKE_ANALYTICS_TRACKING_ID",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:315326805283:parameter/invoicer/FAKE_ANALYTICS_TRACKING_ID"
        }
      ]
    }
  ]
}