# Fake environment variables for development and testing
# DO NOT USE THESE VALUES IN PRODUCTION

# Fake AWS Credentials (for LocalStack testing)
AWS_ACCESS_KEY_ID=fake_aws_access_key_test_12345
AWS_SECRET_ACCESS_KEY=fake_aws_secret_key_abcdefghijklmnop
AWS_DEFAULT_REGION=ap-southeast-1

# Fake LocalStack Configuration
LOCALSTACK_AUTH_TOKEN=fake_localstack_token_xyz789

# Fake Database Credentials
DB_USERNAME=fake_db_user
DB_PASSWORD=fake_db_password_123456
DB_HOST=localhost
DB_PORT=5432
DB_NAME=invoicer_test

# Fake Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=fake_redis_password_123

# Fake Security Keys
JWT_SECRET=fake_jwt_secret_key_for_development_only_do_not_use_in_prod
ENCRYPTION_KEY=fake_encryption_key_sk_test_123456789abcdef
API_KEY_SALT=fake_api_key_salt_xyz123

# Fake Third-Party API Keys
PAYMENT_GATEWAY_API_KEY=pk_test_fake_payment_key_12345abcdef
PAYMENT_GATEWAY_SECRET=sk_test_fake_payment_secret_67890ghijk
NOTIFICATION_SERVICE_KEY=fake_notification_key_abc123
ANALYTICS_API_KEY=fake_analytics_key_def456

# Fake OAuth Configuration
OAUTH_CLIENT_ID=fake_oauth_client_12345
OAUTH_CLIENT_SECRET=fake_oauth_secret_abcdefghijklmnop
OIDC_ISSUER_URI=https://fake-auth-provider.example.com

# Fake Monitoring and Logging
LOG_LEVEL=DEBUG
FAKE_METRICS_ENABLED=true
FAKE_MONITORING_ENDPOINT=http://localhost:9090

# Fake Feature Flags
FEATURE_FAKE_ENCRYPTION=true
FEATURE_FAKE_RATE_LIMITING=true
FEATURE_FAKE_PAYMENT_GATEWAY=true
FEATURE_FAKE_NOTIFICATIONS=false

# Fake Performance Testing
MAX_CONCURRENT_REQUESTS=100
FAKE_LOAD_TEST_DURATION=60
FAKE_RESPONSE_TIME_THRESHOLD=500

# Development Tools
FAKE_DEBUG_MODE=true
FAKE_VERBOSE_LOGGING=true
FAKE_SECURITY_SCANNING=false
